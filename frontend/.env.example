# SIIMS Frontend Environment Variables

# API Base URL
# Point this to the backend server in production (e.g., https://api.yourdomain.com)
# If using the provided Nginx reverse proxy, this can remain /api
VITE_API_URL=/api

# Optional: Google OAuth
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
