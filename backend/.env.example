# SIIMS Backend Environment Variables

# Node Environment (development | production | test)
NODE_ENV=production
PORT=5000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://siims_user:securepassword123@db:5432/siims_db?schema=public"

# Authentication
# Must be a long, randomly generated secure string for production
JWT_SECRET="supersecretkey_change_in_production"

# CORS Configuration
# The URL of the deployed frontend
FRONTEND_URL="http://localhost"

# Email Configuration (for OTPs and Notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@example.com"
SMTP_PASS="your_smtp_password"

# Optional: Google OAuth
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
